{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/packages/tauri-cli/config.schema.json",
  "productName": "NotebookLab",
  "version": "0.8.8",
  "identifier": "com.notebooklab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://github.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "NotebookLab",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/libs/": "llama-libs/",
      "resources/models/ocr/": "models/ocr/"
    },
    "externalBin": [
      "binaries/llama-server"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "Open a PDF in NotebookLab",
        "role": "Viewer"
      },
      {
        "ext": ["docx"],
        "name": "Word document",
        "description": "Open a Word document in NotebookLab",
        "role": "Viewer"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Open a Markdown file in NotebookLab",
        "role": "Viewer"
      },
      {
        "ext": ["txt", "text"],
        "name": "Text document",
        "description": "Open a text file in NotebookLab",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBN0QzM0JDNTE3NDJEMDIKUldRQ0xYUlJ2RE45U3YvYlc3MmVwcjhYNVIwWmdGdlcreTJpaHVhS0tuT0tNdUNGMWhqZm40MysK",
      "endpoints": [
        "https://github.com/Amey-Thakur/NotebookLab/releases/latest/download/latest.json"
      ]
    }
  }
}
